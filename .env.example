# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider/model litellm should use by default.
# Examples: "anthropic/claude-sonnet-4-5", "openai/gpt-4o-mini"
LLM_MODEL=anthropic/claude-sonnet-4-5

# Provide credentials for whichever provider LLM_MODEL points at.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Explicit ceilings enforced by the orchestrator: max model calls per question
# and a soft cost cap, so a runaway loop fails loudly instead of running open.
LLM_MAX_CALLS_PER_QUESTION=5
LLM_MAX_COST_USD_PER_QUESTION=0.50
